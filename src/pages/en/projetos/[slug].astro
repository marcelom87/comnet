---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos_en');
  return projetos.map((projeto) => ({
    params: { slug: projeto.slug },
    props: { projeto },
  }));
}

const lang = 'en';
const { projeto } = Astro.props;
const { Content } = await projeto.render();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${baseUrl}/en`;

const isOngoing = projeto.data.status.toLowerCase().includes('ongoing') || projeto.data.period.toLowerCase().includes('present');

const profSlugMap: Record<string, string> = {
  'marcelo antonio marotta': 'marotta',
  'andre costa drummond': 'andred',
  'eduardo adilio pelinson alchieri': 'alchieri',
  'jacir luiz bordim': 'bordim',
  'celia ghedini ralha': 'celia',
  'priscila america solis mendez barreto': 'pris',
  'geraldo pereira rocha filho': 'geraldo',
  'marcos fagundes caetano': 'marcosfcaetano',
  'roberto vito rodrigues filho': 'roberto',
  'marcus vinicius lamar': 'lamar',
};

function getProfessorSlug(name: string): string | null {
  const norm = name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
  for (const [key, pSlug] of Object.entries(profSlugMap)) {
    if (norm.includes(key) || key.includes(norm)) {
      return pSlug;
    }
  }
  return null;
}
---

<BaseLayout
  lang={lang}
  title={`${projeto.data.title} | COMNET — CIC / UnB`}
  description={`Research project details for ${projeto.data.title} at COMNET Laboratory, University of Brasília.`}
>
  <div class="bg-gradient-to-r from-unb-blue via-slate-900 to-emerald-950 text-white py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <a href={`${prefix}/projetos/`} class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1 transition-colors">
          <span>←</span>
          <span>Back to Projects</span>
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class={`text-xs font-bold px-2.5 py-1 rounded-md ${
          isOngoing ? 'bg-emerald-500 text-slate-950 font-extrabold' : 'bg-slate-700 text-slate-200'
        }`}>
          {isOngoing ? '● Ongoing Project' : '✓ Completed'}
        </span>
        <span class="text-xs font-semibold text-slate-300 bg-white/10 px-2.5 py-1 rounded-md">
          📅 {projeto.data.period}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-snug">
        {projeto.data.title}
      </h1>

      <p class="text-emerald-300 font-medium text-sm mt-3">
        Principal Investigator: {projeto.data.coordinator}
      </p>

      <!-- Project Tags in Header -->
      {projeto.data.tags && projeto.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4">
          {projeto.data.tags.map((tag) => (
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-white/15 text-emerald-200 border border-white/20">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Project Body -->
      <div class="lg:col-span-2 space-y-6">
        <!-- COMNET Faculty Highlight Box -->
        {projeto.data.professors && projeto.data.professors.length > 0 && (
          <div class="p-6 rounded-2xl bg-gradient-to-r from-emerald-50 to-blue-50/70 border border-emerald-200 shadow-sm">
            <h3 class="text-xs font-extrabold text-emerald-900 uppercase tracking-wider flex items-center gap-2 mb-3">
              <span>👥</span>
              <span>Participating COMNET Faculty Members</span>
            </h3>
            <div class="flex flex-wrap gap-2">
              {projeto.data.professors.map((prof) => {
                const slug = getProfessorSlug(prof);
                return slug ? (
                  <a
                    href={`${prefix}/professores/${slug}/`}
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-white text-emerald-950 border border-emerald-300 hover:bg-emerald-600 hover:text-white transition-all shadow-xs"
                  >
                    <span>🎓</span>
                    <span>{prof}</span>
                    <span class="text-[10px] text-emerald-500 hover:text-white">↗</span>
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-slate-800 border border-slate-200 shadow-xs">
                    <span>👤</span>
                    <span>{prof}</span>
                  </span>
                );
              })}
            </div>
          </div>
        )}

        <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm prose prose-slate max-w-none prose-headings:text-unb-blue">
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4 border-b border-slate-100 pb-2">
            Project Metadata
          </h3>
          <dl class="space-y-3.5 text-xs">
            <div>
              <dt class="font-bold text-slate-400 uppercase">Duration</dt>
              <dd class="text-slate-800 font-semibold mt-0.5">{projeto.data.period}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-400 uppercase">Coordinator</dt>
              <dd class="text-slate-800 font-semibold mt-0.5">{projeto.data.coordinator}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-400 uppercase">Sponsor</dt>
              <dd class="text-slate-800 font-semibold mt-0.5">{projeto.data.funding || 'Institutional / Direct Grants'}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-400 uppercase">Status</dt>
              <dd class="text-slate-800 font-semibold mt-0.5">{isOngoing ? 'Ongoing' : 'Completed'}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-400 uppercase">COMNET Faculty</dt>
              <dd class="text-slate-800 font-medium mt-0.5">
                {(projeto.data.professors || []).join(', ') || projeto.data.coordinator}
              </dd>
            </div>
          </dl>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
          <h4 class="text-xs font-bold text-slate-700 uppercase mb-2">Host Institution</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            COMNET Laboratory • Department of Computer Science (CIC) • University of Brasília (UnB).
          </p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
