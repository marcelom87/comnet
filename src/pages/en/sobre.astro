---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  lang={lang}
  title="About & Contact | COMNET — CIC / UnB"
  description="History, CNPq-certified research groups, testbed infrastructure, location at CIC/EST Building, and contact information for the COMNET Laboratory at the University of Brasília."
>
  <section class="bg-gradient-to-r from-unb-blue to-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800 px-3 py-1 rounded-full">
          {t('about.tag')}
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold mt-3">
          {t('about.title')}
        </h1>
        <p class="text-slate-300 mt-3 text-base sm:text-lg leading-relaxed">
          {t('about.subtitle')}
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    
    <!-- Presentation & Overview -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <h2 class="text-3xl font-extrabold text-slate-900">
          Pioneering Research at the Department of Computer Science
        </h2>
        <p class="text-slate-600 leading-relaxed">
          The <strong>COMNET (Computer Networks Laboratory)</strong> is based in the Department of Computer Science (CIC) at the University of Brasília (UnB). The lab operates at the vital intersection of physical telecommunications infrastructure, resilient distributed systems, and applied computational intelligence.
        </p>
        <p class="text-slate-600 leading-relaxed">
          Our multidisciplinary team of professors, postdocs, Ph.D. candidates, master's students, and undergraduate researchers investigates challenging questions in optimal resource allocation, network function virtualization, open 5G/6G architectures (O-RAN), distributed fault tolerance, elastic optical networks, privacy, and IoT for smart connected communities.
        </p>

        <div class="grid grid-cols-2 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-slate-100 border border-slate-200">
            <div class="text-2xl font-bold text-unb-blue">UnB • CIC</div>
            <p class="text-xs text-slate-500 mt-1">Graduate Program in Informatics (PPGI)</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-100 border border-slate-200">
            <div class="text-2xl font-bold text-unb-green">FAPDF & CNPq</div>
            <p class="text-xs text-slate-500 mt-1">Government and industry research grants</p>
          </div>
        </div>
      </div>

      <!-- Lab Images -->
      <div class="space-y-4">
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-md">
          <img
            src={`${baseUrl}/images/lab.jpg`}
            alt="COMNET laboratory testbed and infrastructure"
            class="w-full h-64 object-cover"
          />
        </div>
        <p class="text-xs text-slate-500 italic text-center">
          Hardware benches, SDRs, and simulation servers at the CIC/EST Building.
        </p>
      </div>
    </div>

    <!-- CNPq-Certified Research Groups -->
    <section class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full">
            Directory of Research Groups (DGP)
          </span>
          <h3 class="text-2xl font-extrabold text-slate-900 mt-2">
            {t('about.groups.title')}
          </h3>
          <p class="text-sm text-slate-500 mt-1">
            {t('about.groups.subtitle')}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Group 1: LARF -->
        <div class="p-6 rounded-2xl bg-gradient-to-br from-slate-50 to-blue-50/40 border border-slate-200 hover:border-unb-blue transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-blue-100 text-unb-blue border border-blue-200">
                CNPq • Since 2011
              </span>
              <span class="text-xs text-slate-400 font-medium">UnB • CIC</span>
            </div>
            <h4 class="text-xl font-bold text-slate-900">
              LARF — Future Networks Laboratory
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Dedicated to scientific and technological advances in mobile networks (5G/6G), network softwarization (SDN/NFV), cognitive radio networks, network slicing, traffic-driven artificial intelligence, and secure telecommunications.
            </p>
          </div>
          <div class="pt-5 border-t border-slate-200/60 mt-4">
            <a
              href="http://dgp.cnpq.br/dgp/espelhogrupo/0240103KT1AMW3"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-bold text-unb-blue hover:text-unb-green transition-colors"
            >
              <span>View CNPq Group Profile</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>
        </div>

        <!-- Group 2: InfoKnow -->
        <div class="p-6 rounded-2xl bg-gradient-to-br from-slate-50 to-emerald-50/40 border border-slate-200 hover:border-emerald-500 transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-200">
                CNPq • Since 2005
              </span>
              <span class="text-xs text-slate-400 font-medium">UnB • CIC</span>
            </div>
            <h4 class="text-xl font-bold text-slate-900">
              InfoKnow — Computer Systems for Information and Knowledge Treatment
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Focused on intelligent systems, particularly models based on intelligent agents, multi-agent systems (MAS), multi-agent planning, data and process mining, computational forensics, and applied ontologies.
            </p>
          </div>
          <div class="pt-5 border-t border-slate-200/60 mt-4">
            <a
              href="http://dgp.cnpq.br/dgp/espelhogrupo/024010360AHR2C"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-bold text-emerald-700 hover:text-emerald-900 transition-colors"
            >
              <span>View CNPq Group Profile</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Infrastructure & Testbeds Section -->
    <section class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
      <h3 class="text-2xl font-bold text-slate-900 mb-6">{t('about.infrastructure.title')}</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-xl bg-slate-50 border border-slate-100 space-y-2">
          <div class="text-2xl">🖥️</div>
          <h4 class="font-bold text-slate-800 text-sm">High-Performance Compute Clusters</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Virtualized environments with support for OpenStack, Kubernetes, Mininet, and large-scale emulation of 5G core and RAN topologies.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-100 space-y-2">
          <div class="text-2xl">📡</div>
          <h4 class="font-bold text-slate-800 text-sm">Software-Defined Radios (SDR)</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            USRP devices and rapid prototyping boards for experimental evaluation of physical layer, MAC protocols, and cognitive radio algorithms.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-100 space-y-2">
          <div class="text-2xl">⚡</div>
          <h4 class="font-bold text-slate-800 text-sm">IoT & Vehicular Testbeds</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Equipment and sensor motes for real-world experimentation with LoRaWAN, ZigBee, WiFi 6/7, and connected vehicle on-board units.
          </p>
        </div>
      </div>
    </section>

    <!-- Research Grants & Partners (Logos) -->
    <section class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-100 px-3 py-1 rounded-full">
          Funding Agencies & Research Grants
        </span>
        <h3 class="text-2xl font-bold text-slate-900 mt-2">
          {t('about.partners.title')}
        </h3>
        <p class="text-sm text-slate-500 mt-1">
          {t('about.partners.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 items-center justify-items-center pt-4">
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-24 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/cnpq.jpg`} alt="CNPq" class="max-h-12 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-24 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/capes.jpg`} alt="CAPES" class="max-h-12 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-24 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/fapdf.jpg`} alt="FAPDF" class="max-h-12 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-24 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/rnp.gif`} alt="RNP" class="max-h-10 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-24 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/finep.jpg`} alt="FINEP" class="max-h-10 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-24 flex items-center justify-center hover:shadow-xs transition-shadow">
          <span class="text-xs font-bold text-slate-700 text-center tracking-tight">MCTI / Minicom</span>
        </div>
      </div>
    </section>

    <!-- History & Laboratory Legacy (Legacy Logo) -->
    <section class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2 space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-600 bg-white border border-slate-200 px-3 py-1 rounded-full shadow-2xs">
            Institutional Memory
          </span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
            {t('about.legacy.title')}
          </h3>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Established in the early 2000s in the Department of Computer Science at the University of Brasília, <strong>COMNET</strong> served as a collaborative hub for researchers focused on internet routing, optical networking, fault tolerance, and distributed computing.
          </p>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Over more than two decades, the laboratory actively shaped landmark Brazilian science and technology programs — from early RNP and FAPDF efforts (such as the RUCA and Casadinho initiatives) to prominent global telecommunications projects (such as 5G-RANGE and cutting-edge 6G networks).
          </p>
        </div>

        <div class="flex flex-col items-center justify-center bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
          <img
            src={`${baseUrl}/images/legacy/logocomnet_legacy.png`}
            alt="Historical visual identity of COMNET"
            class="max-w-[220px] h-auto object-contain mb-3"
          />
          <span class="text-2xs font-semibold uppercase tracking-wider text-slate-400 bg-slate-50 border border-slate-200 px-2.5 py-0.5 rounded-full text-center">
            2000s Legacy Laboratory Logo
          </span>
          <p class="text-2xs text-slate-400 text-center mt-2">
            Preserved as a historical tribute to the laboratory's founders and alumni generations.
          </p>
        </div>
      </div>
    </section>

    <!-- Google Maps & Contact Info -->
    <MapEmbed lang={lang} />

  </div>
</BaseLayout>
