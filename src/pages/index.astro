---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProfessorCard from '../components/ProfessorCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL;

// Fetch professors ordered alphabetically by name
const allProfessores = await getCollection('professores');
const professores = allProfessores.sort((a, b) => a.data.name.localeCompare(b.data.name, 'pt-BR'));

// Fetch active projects sorted chronologically then alphabetically
const allProjetos = await getCollection('projetos');
const sortedProjetos = allProjetos.sort((a, b) => {
  const aMatch = a.data.period.match(/([0-9]{4})\s*-\s*(Atual|[0-9]{4})/i);
  const bMatch = b.data.period.match(/([0-9]{4})\s*-\s*(Atual|[0-9]{4})/i);
  const aStart = aMatch ? parseInt(aMatch[1], 10) : 0;
  const bStart = bMatch ? parseInt(bMatch[1], 10) : 0;
  const aOngoing = a.data.period.toLowerCase().includes('atual') || a.data.status.toLowerCase().includes('andamento');
  const bOngoing = b.data.period.toLowerCase().includes('atual') || b.data.status.toLowerCase().includes('andamento');
  if (aOngoing !== bOngoing) return bOngoing ? 1 : -1;
  if (bStart !== aStart) return bStart - aStart;
  return a.data.title.localeCompare(b.data.title, 'pt-BR');
});

// Apenas projetos ativos na página inicial
const activeProjetos = sortedProjetos.filter(
  (p) => p.data.period.toLowerCase().includes('atual') || p.data.status.toLowerCase().includes('andamento')
);
const homeActiveProjetos = activeProjetos.slice(0, 6);

const researchLines = [
  {
    icon: '📶',
    title: 'Redes Sem Fio, 5G & 6G',
    desc: 'Arquiteturas C-RAN/O-RAN, alocação dinâmica e oportunista de espectro (OSA), computação na borda e comunicação de ultra-baixa latência.'
  },
  {
    icon: '⚡',
    title: 'Softwarização de Redes (SDN/NFV)',
    desc: 'Programabilidade de planos de dados (P4, OpenFlow), virtualização de funções de rede e orquestração de fatiamento de rede (Network Slicing).'
  },
  {
    icon: '💡',
    title: 'Redes Ópticas WDM & Engenharia de Tráfego',
    desc: 'Redes ópticas elásticas (EON), grooming de tráfego, redução de retardo entre tarefas em grades e otimização de rotas com QoS.'
  },
  {
    icon: '🌐',
    title: 'Internet das Coisas & Cidades Inteligentes',
    desc: 'Protocolos de comunicação para IoT, redes de sensores sem fio (WSN), cidades inteligentes (CIA2) e redes veiculares conectadas (VANETs).'
  },
  {
    icon: '🛡️',
    title: 'Sistemas Distribuídos & Tolerância a Falhas',
    desc: 'Algoritmos de consenso bizantino, replicação por quóruns, sistemas distribuídos dinâmicos e arquiteturas resilientes a intrusões.'
  },
  {
    icon: '🤖',
    title: 'Redes Baseadas em Intenção & Inteligência Artificial',
    desc: 'Aprendizado por Reforço, Aprendizado Federado e modelos preditivos aplicados ao gerenciamento autônomo e zero-touch de redes.'
  },
  {
    icon: '👥',
    title: 'Sistemas Multiagentes & Computação Forense',
    desc: 'Modelos baseados em agentes (BDI), cooperação e planejamento multiagente, mineração de processos e análise pericial distribuída (MADIK).'
  },
  {
    icon: '🔒',
    title: 'Segurança Cibernética & Criptografia',
    desc: 'Implementação eficiente de primitivas criptográficas, privacidade, anonimato, detecção de intrusão e segurança em redes descentralizadas.'
  }
];
---

<BaseLayout
  title="COMNET — Laboratório de Redes de Comunicações | UnB"
  description="Pesquisa de ponta em Redes 5G/6G, Sistemas Distribuídos, Softwarização e Inteligência Artificial no Departamento de Ciência da Computação da UnB."
>
  <!-- Hero Section com Imagens do Laboratório -->
  <Hero />

  <!-- Missão & Visão -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Card Missão -->
        <div class="p-8 rounded-2xl bg-gradient-to-br from-slate-50 to-emerald-50/30 border border-slate-200/80 shadow-sm relative overflow-hidden group">
          <div class="w-12 h-12 rounded-xl bg-unb-blue text-white flex items-center justify-center text-2xl font-bold mb-4 shadow-sm group-hover:scale-110 transition-transform">
            🎯
          </div>
          <h2 class="text-2xl font-bold text-slate-900 mb-3">Nossa Missão</h2>
          <p class="text-slate-600 leading-relaxed">
            Produzir pesquisa científica e inovação tecnológica de padrão internacional nas áreas de redes de computadores e sistemas distribuídos, formando recursos humanos qualificados em níveis de graduação e pós-graduação capazes de liderar transformações na academia e na indústria.
          </p>
        </div>

        <!-- Card Visão -->
        <div class="p-8 rounded-2xl bg-gradient-to-br from-slate-50 to-blue-50/30 border border-slate-200/80 shadow-sm relative overflow-hidden group">
          <div class="w-12 h-12 rounded-xl bg-unb-green text-white flex items-center justify-center text-2xl font-bold mb-4 shadow-sm group-hover:scale-110 transition-transform">
            🚀
          </div>
          <h2 class="text-2xl font-bold text-slate-900 mb-3">Nossa Visão</h2>
          <p class="text-slate-600 leading-relaxed">
            Consolidar o COMNET como um centro de excelência e referência nacional e internacional no desenvolvimento das redes do futuro (6G, redes autônomas e IBN), fomentando parcerias estratégicas com órgãos governamentais, agências de fomento e o setor produtivo.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Linhas de Pesquisa -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full">
          Áreas de Investigação
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">
          Linhas de Pesquisa Estratégicas
        </h2>
        <p class="text-base text-slate-600 mt-4 leading-relaxed">
          Nossas frentes de pesquisa cobrem desde a camada física e óptica até inteligência artificial e segurança cibernética em larga escala.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {researchLines.map((line) => (
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:border-emerald-500/40 transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-2xl mb-4">
              {line.icon}
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">
              {line.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              {line.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projetos Ativos em Destaque -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full border border-emerald-300">
            ● Projetos Vigentes ({activeProjetos.length} ativos)
          </span>
          <h2 class="text-3xl font-extrabold text-slate-900 mt-3">
            Projetos Ativos de Pesquisa e Inovação
          </h2>
          <p class="text-slate-600 mt-2">
            Iniciativas de pesquisa científica e tecnológica atualmente vigentes no COMNET.
          </p>
        </div>
        <a
          href={`${baseUrl}projetos/?status=ongoing`}
          class="mt-4 md:mt-0 inline-flex items-center gap-1.5 text-sm font-bold text-unb-blue hover:text-unb-green transition-colors"
        >
          <span>Ver todos os {activeProjetos.length} projetos ativos</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {homeActiveProjetos.map((proj) => {
          const cleanSnippet = proj.body.replace(/^##\s+[^\n]+\n+/gm, '').trim().substring(0, 150) + '...';
          return (
            <ProjectCard
              slug={proj.slug}
              title={proj.data.title}
              period={proj.data.period}
              coordinator={proj.data.coordinator}
              funding={proj.data.funding}
              status={proj.data.status}
              featured={proj.data.featured}
              professors={proj.data.professors}
              tags={proj.data.tags}
              descriptionSnippet={cleanSnippet}
            />
          );
        })}
      </div>

      <div class="mt-10 text-center">
        <a
          href={`${baseUrl}projetos/`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 hover:bg-unb-blue text-white font-bold text-sm transition-all shadow-sm"
        >
          <span>Explorar acervo completo com todos os {allProjetos.length} projetos</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Corpo Docente / Professores -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full">
            Corpo Docente
          </span>
          <h2 class="text-3xl font-extrabold text-slate-900 mt-3">
            Professores Pesquisadores
          </h2>
          <p class="text-slate-600 mt-2">
            Docentes e orientadores credenciados no Departamento de Ciência da Computação da UnB.
          </p>
        </div>
        <a
          href={`${baseUrl}professores/`}
          class="mt-4 md:mt-0 inline-flex items-center gap-1.5 text-sm font-bold text-unb-blue hover:text-unb-green transition-colors"
        >
          <span>Ver todos os membros</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {professores.slice(0, 6).map((prof) => (
          <ProfessorCard
            id={prof.slug}
            name={prof.data.name}
            role={prof.data.role}
            email={prof.data.email}
            lattesUrl={prof.data.lattesUrl}
            areas={prof.data.areas}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Apoio, Fomento e Parcerias -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-100 px-3 py-1 rounded-full border border-slate-200">
          Apoio & Parcerias
        </span>
        <h2 class="text-2xl font-extrabold text-slate-900 mt-2">
          Agências de Fomento e Cooperação Tecnológica
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Nossa pesquisa e inovação contam com o apoio e financiamento das principais agências e instituições de fomento científico.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 items-center justify-items-center">
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-20 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/cnpq.jpg`} alt="CNPq" class="max-h-10 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-20 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/capes.jpg`} alt="CAPES" class="max-h-10 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-20 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/fapdf.jpg`} alt="FAPDF" class="max-h-10 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-20 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/rnp.gif`} alt="RNP" class="max-h-8 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-20 flex items-center justify-center hover:shadow-xs transition-shadow">
          <img src={`${baseUrl}/images/partners/finep.jpg`} alt="FINEP" class="max-h-8 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all" />
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl w-full h-20 flex items-center justify-center hover:shadow-xs transition-shadow">
          <span class="text-xs font-bold text-slate-700 text-center tracking-tight">MCTI / Minicom</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção de Localização e Contato -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <MapEmbed />
    </div>
  </section>
</BaseLayout>

