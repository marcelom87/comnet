---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfessorCard from '../../components/ProfessorCard.astro';
import { getCollection } from 'astro:content';

const allProfessores = await getCollection('professores');
const professores = allProfessores.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Membros & Professores | COMNET — CIC / UnB"
  description="Conheça os professores pesquisadores e membros do Laboratório COMNET da Universidade de Brasília."
>
  <!-- Header da Página -->
  <section class="bg-gradient-to-r from-unb-blue to-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800 px-3 py-1 rounded-full">
          Corpo Docente & Pesquisadores
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold mt-3">
          Membros do Laboratório
        </h1>
        <p class="text-slate-300 mt-3 text-base sm:text-lg leading-relaxed">
          O COMNET reúne docentes com ampla experiência em telecomunicações, redes de computadores, inteligência artificial, cidades inteligentes e sistemas distribuídos.
        </p>
      </div>
    </div>
  </section>

  <!-- Grade dos 10 Professores -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {professores.map((prof) => (
          <ProfessorCard
            id={prof.slug}
            name={prof.data.name}
            role={prof.data.role}
            email={prof.data.email}
            lattesUrl={prof.data.lattesUrl}
            areas={prof.data.areas}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
