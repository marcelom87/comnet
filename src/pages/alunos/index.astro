---
import BaseLayout from '../../layouts/BaseLayout.astro';
import alunosData from '../../data/alunos.json';

const { active, alumni } = alunosData;
---

<BaseLayout
  title="Alunos Ativos & Egressos | COMNET — CIC / UnB"
  description="Quadro de alunos em formação e egressos (Doutorado, Mestrado e Graduação) do Laboratório COMNET da Universidade de Brasília."
>
  <!-- Banner Topo -->
  <section class="bg-gradient-to-r from-unb-blue to-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800 px-3 py-1 rounded-full">
          Formação de Recursos Humanos
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold mt-3">
          Alunos & Egressos
        </h1>
        <p class="text-slate-300 mt-3 text-base sm:text-lg leading-relaxed">
          O COMNET orgulha-se de participar da formação de dezenas de mestres, doutores e pesquisadores de destaque no Brasil e no exterior.
        </p>
      </div>
    </div>
  </section>

  <!-- Navegação Interna por Âncoras -->
  <div class="bg-white border-b border-slate-200 sticky top-20 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex gap-4 overflow-x-auto text-sm font-semibold">
      <a href="#ativos" class="text-unb-blue hover:text-unb-green px-3 py-1.5 rounded-md hover:bg-slate-100 transition-colors whitespace-nowrap">
        ● Alunos Ativos ({active.length})
      </a>
      <a href="#doutorado" class="text-slate-700 hover:text-unb-green px-3 py-1.5 rounded-md hover:bg-slate-100 transition-colors whitespace-nowrap">
        🎓 Egressos: Doutorado ({alumni.doutorado.length})
      </a>
      <a href="#mestrado" class="text-slate-700 hover:text-unb-green px-3 py-1.5 rounded-md hover:bg-slate-100 transition-colors whitespace-nowrap">
        📜 Egressos: Mestrado ({alumni.mestrado.length})
      </a>
      <a href="#graduacao" class="text-slate-700 hover:text-unb-green px-3 py-1.5 rounded-md hover:bg-slate-100 transition-colors whitespace-nowrap">
        🏛️ Egressos: Graduação ({alumni.graduacao.length})
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- SEÇÃO 1: ALUNOS ATIVOS -->
    <section id="ativos" class="scroll-mt-36">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full">
            Orientações em Andamento
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">
            Alunos Ativos
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Ordenados em ordem alfabética pelo primeiro nome.
          </p>
        </div>
        <span class="text-sm font-bold bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg border border-slate-200">
          Total: {active.length} alunos
        </span>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-100/80 border-b border-slate-200 text-slate-700 font-bold uppercase text-xs tracking-wider">
              <tr>
                <th scope="col" class="py-4 px-6">Nome do Aluno</th>
                <th scope="col" class="py-4 px-6">Nome do Orientador</th>
                <th scope="col" class="py-4 px-6">Nível</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {active.map((aluno: any) => (
                <tr class="hover:bg-emerald-50/40 transition-colors">
                  <td class="py-3.5 px-6 font-semibold text-slate-900">
                    {aluno.name}
                  </td>
                  <td class="py-3.5 px-6 text-slate-600">
                    {aluno.advisor}
                  </td>
                  <td class="py-3.5 px-6">
                    <span class={`inline-block text-xs font-bold px-2.5 py-0.5 rounded-full ${
                      aluno.level.toLowerCase().includes('doutor')
                        ? 'bg-purple-100 text-purple-800 border border-purple-200'
                        : aluno.level.toLowerCase().includes('mestr')
                        ? 'bg-blue-100 text-blue-800 border border-blue-200'
                        : 'bg-emerald-100 text-emerald-800 border border-emerald-200'
                    }`}>
                      {aluno.level}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- SEÇÃO 2: EGRESSOS (DOUTORADO) -->
    <section id="doutorado" class="scroll-mt-36">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-purple-700 bg-purple-100 px-3 py-1 rounded-full">
            Orientações Concluídas
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">
            Egressos — Doutorado
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Organizados por ordem cronológica decrescente (ano de conclusão) e, em seguida, ordem alfabética.
          </p>
        </div>
        <span class="text-sm font-bold bg-purple-50 text-purple-700 px-3 py-1.5 rounded-lg border border-purple-200">
          {alumni.doutorado.length} Teses Concluídas
        </span>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <ul class="divide-y divide-slate-100">
          {alumni.doutorado.map((egresso: any) => (
            <li class="p-5 hover:bg-slate-50 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-900">{egresso.name}</span>
                  <span class="text-xs font-bold px-2 py-0.5 rounded bg-purple-100 text-purple-800">
                    {egresso.year}
                  </span>
                </div>
                {egresso.title && (
                  <p class="text-xs text-slate-600 italic max-w-3xl">
                    "{egresso.title}"
                  </p>
                )}
                <p class="text-xs text-slate-500">
                  <strong>Orientação:</strong> {egresso.advisor}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- SEÇÃO 3: EGRESSOS (MESTRADO) -->
    <section id="mestrado" class="scroll-mt-36">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-100 px-3 py-1 rounded-full">
            Orientações Concluídas
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">
            Egressos — Mestrado
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Organizados por ordem cronológica decrescente (ano de conclusão) e, em seguida, ordem alfabética.
          </p>
        </div>
        <span class="text-sm font-bold bg-blue-50 text-blue-700 px-3 py-1.5 rounded-lg border border-blue-200">
          {alumni.mestrado.length} Dissertações Concluídas
        </span>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <ul class="divide-y divide-slate-100">
          {alumni.mestrado.map((egresso: any) => (
            <li class="p-5 hover:bg-slate-50 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-900">{egresso.name}</span>
                  <span class="text-xs font-bold px-2 py-0.5 rounded bg-blue-100 text-blue-800">
                    {egresso.year}
                  </span>
                </div>
                {egresso.title && (
                  <p class="text-xs text-slate-600 italic max-w-3xl">
                    "{egresso.title}"
                  </p>
                )}
                <p class="text-xs text-slate-500">
                  <strong>Orientação:</strong> {egresso.advisor}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- SEÇÃO 4: EGRESSOS (GRADUAÇÃO / IC) -->
    <section id="graduacao" class="scroll-mt-36">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full">
            Orientações Concluídas
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">
            Egressos — Graduação & Iniciação Científica
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Organizados por ordem cronológica decrescente (ano de conclusão) e, em seguida, ordem alfabética.
          </p>
        </div>
        <span class="text-sm font-bold bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg border border-emerald-200">
          {alumni.graduacao.length} Trabalhos Concluídos
        </span>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <ul class="divide-y divide-slate-100 max-h-[700px] overflow-y-auto">
          {alumni.graduacao.map((egresso: any) => (
            <li class="p-4 hover:bg-slate-50 transition-colors">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold text-slate-900">{egresso.name}</span>
                  <span class="text-xs font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800">
                    {egresso.year}
                  </span>
                </div>
                {egresso.title && (
                  <p class="text-xs text-slate-600 italic">
                    "{egresso.title}"
                  </p>
                )}
                <p class="text-xs text-slate-500">
                  <strong>Orientação:</strong> {egresso.advisor}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

  </div>
</BaseLayout>

