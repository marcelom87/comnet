---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjetos = await getCollection('projetos');

// Sort: Primary Chronological (descending), Secondary Alphabetical
function sortProjects(list: typeof allProjetos) {
  return list.sort((a, b) => {
    const aMatch = a.data.period.match(/([0-9]{4})\s*-\s*(Atual|Present|[0-9]{4})/i);
    const bMatch = b.data.period.match(/([0-9]{4})\s*-\s*(Atual|Present|[0-9]{4})/i);

    const aStart = aMatch ? parseInt(aMatch[1], 10) : 0;
    const bStart = bMatch ? parseInt(bMatch[1], 10) : 0;

    const aOngoing = a.data.period.toLowerCase().includes('atual') || a.data.status.toLowerCase().includes('andamento');
    const bOngoing = b.data.period.toLowerCase().includes('atual') || b.data.status.toLowerCase().includes('andamento');

    // 1. Ongoing projects first
    if (aOngoing !== bOngoing) {
      return bOngoing ? 1 : -1;
    }

    // 2. Start year descending
    if (bStart !== aStart) {
      return bStart - aStart;
    }

    // 3. End year descending
    const aEnd = aMatch && !aOngoing && !isNaN(parseInt(aMatch[2], 10)) ? parseInt(aMatch[2], 10) : 0;
    const bEnd = bMatch && !bOngoing && !isNaN(parseInt(bMatch[2], 10)) ? parseInt(bMatch[2], 10) : 0;
    if (bEnd !== aEnd) {
      return bEnd - aEnd;
    }

    // 4. Secondary: Alphabetical by Title
    return a.data.title.localeCompare(b.data.title, 'pt-BR');
  });
}

const projetos = sortProjects(allProjetos);
const ongoingCount = projetos.filter(p => p.data.status.includes('andamento') || p.data.period.includes('Atual')).length;
const completedCount = projetos.length - ongoingCount;
---

<BaseLayout
  title="Projetos de Pesquisa | COMNET — CIC / UnB"
  description="Acervo completo de projetos de pesquisa científica e tecnológica desenvolvidos pelos pesquisadores do Laboratório COMNET da Universidade de Brasília."
>
  <section class="bg-gradient-to-r from-unb-blue to-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800 px-3 py-1 rounded-full">
          P&D e Inovação Científica
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold mt-3">
          Projetos de Pesquisa
        </h1>
        <p class="text-slate-300 mt-3 text-base sm:text-lg leading-relaxed">
          Acervo histórico e projetos vigentes do COMNET. Organizados primariamente em ordem cronológica decrescente e, em seguida, em ordem alfabética.
        </p>

        <div class="flex flex-wrap gap-3 mt-6">
          <span class="px-3.5 py-1.5 rounded-lg bg-white/10 text-xs font-semibold text-white border border-white/20">
            📊 Total: <strong>{projetos.length}</strong> projetos
          </span>
          <span class="px-3.5 py-1.5 rounded-lg bg-emerald-500/20 text-xs font-semibold text-emerald-300 border border-emerald-400/30">
            ● <strong>{ongoingCount}</strong> em andamento
          </span>
          <span class="px-3.5 py-1.5 rounded-lg bg-slate-700/50 text-xs font-semibold text-slate-300 border border-slate-600/50">
            ✓ <strong>{completedCount}</strong> concluídos
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtro e Busca Rápida -->
  <section class="py-8 bg-white border-b border-slate-200 sticky top-20 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <!-- Input de Busca -->
      <div class="relative w-full sm:w-96">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
          🔍
        </span>
        <input
          type="text"
          id="project-search"
          placeholder="Buscar projeto por título, coordenador ou financiador..."
          class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-unb-blue focus:border-unb-blue bg-slate-50 transition-all"
        />
      </div>

      <!-- Filtros por Status -->
      <div class="flex items-center gap-2 self-start sm:self-auto text-xs font-semibold" id="filter-buttons">
        <button
          type="button"
          data-filter="all"
          class="filter-btn active px-3 py-1.5 rounded-lg bg-unb-blue text-white transition-all shadow-xs"
        >
          Todos ({projetos.length})
        </button>
        <button
          type="button"
          data-filter="ongoing"
          class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all"
        >
          Em Andamento ({ongoingCount})
        </button>
        <button
          type="button"
          data-filter="completed"
          class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all"
        >
          Concluídos ({completedCount})
        </button>
      </div>
    </div>
  </section>

  <!-- Grade Completa de Projetos -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projetos.map((proj) => {
          const isOngoing = proj.data.status.includes('andamento') || proj.data.period.includes('Atual');
          const cleanSnippet = proj.body.replace(/^##\s+[^\n]+\n+/gm, '').trim().substring(0, 160) + '...';
          return (
            <div
              class="project-item"
              data-status={isOngoing ? 'ongoing' : 'completed'}
              data-text={`${proj.data.title} ${proj.data.coordinator} ${proj.data.funding}`.toLowerCase()}
            >
              <ProjectCard
                slug={proj.slug}
                title={proj.data.title}
                period={proj.data.period}
                coordinator={proj.data.coordinator}
                funding={proj.data.funding}
                status={proj.data.status}
                featured={proj.data.featured}
                descriptionSnippet={cleanSnippet}
              />
            </div>
          );
        })}
      </div>

      <div id="no-results" class="hidden text-center py-16">
        <p class="text-slate-400 text-lg">Nenhum projeto encontrado com os termos pesquisados.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.project-item');
  const noResults = document.getElementById('no-results');

  let currentFilter = 'all';
  let searchTerm = '';

  function applyFilters() {
    let visibleCount = 0;
    items.forEach((item) => {
      const el = item as HTMLElement;
      const status = el.dataset.status;
      const text = el.dataset.text || '';

      const matchesStatus = currentFilter === 'all' || status === currentFilter;
      const matchesSearch = searchTerm === '' || text.includes(searchTerm);

      if (matchesStatus && matchesSearch) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-unb-blue', 'text-white', 'shadow-xs');
        b.classList.add('bg-slate-100', 'text-slate-700');
      });
      btn.classList.remove('bg-slate-100', 'text-slate-700');
      btn.classList.add('bg-unb-blue', 'text-white', 'shadow-xs');

      currentFilter = (btn as HTMLElement).dataset.filter || 'all';
      applyFilters();
    });
  });
</script>
