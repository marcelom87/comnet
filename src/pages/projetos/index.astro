---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjetos = await getCollection('projetos');

// Sort: Primary Chronological (descending, ongoing first), Secondary Alphabetical
function sortProjects(list: typeof allProjetos) {
  return list.sort((a, b) => {
    const aMatch = a.data.period.match(/([0-9]{4})\s*-\s*(Atual|Present|[0-9]{4})/i);
    const bMatch = b.data.period.match(/([0-9]{4})\s*-\s*(Atual|Present|[0-9]{4})/i);

    const aStart = aMatch ? parseInt(aMatch[1], 10) : 0;
    const bStart = bMatch ? parseInt(bMatch[1], 10) : 0;

    const aOngoing = a.data.period.toLowerCase().includes('atual') || a.data.status.toLowerCase().includes('andamento');
    const bOngoing = b.data.period.toLowerCase().includes('atual') || b.data.status.toLowerCase().includes('andamento');

    // 1. Ongoing projects first
    if (aOngoing !== bOngoing) {
      return bOngoing ? 1 : -1;
    }

    // 2. Start year descending
    if (bStart !== aStart) {
      return bStart - aStart;
    }

    // 3. End year descending
    const aEnd = aMatch && !aOngoing && !isNaN(parseInt(aMatch[2], 10)) ? parseInt(aMatch[2], 10) : 0;
    const bEnd = bMatch && !bOngoing && !isNaN(parseInt(bMatch[2], 10)) ? parseInt(bMatch[2], 10) : 0;
    if (bEnd !== aEnd) {
      return bEnd - aEnd;
    }

    // 4. Secondary: Alphabetical by Title
    return a.data.title.localeCompare(b.data.title, 'pt-BR');
  });
}

const projetos = sortProjects(allProjetos);
const ongoingCount = projetos.filter(p => p.data.status.toLowerCase().includes('andamento') || p.data.period.toLowerCase().includes('atual')).length;
const completedCount = projetos.length - ongoingCount;

// Distinct COMNET professors for quick filter dropdown
const comnetProfessors = [
  'André Costa Drummond',
  'Célia Ghedini Ralha',
  'Eduardo Adilio Pelinson Alchieri',
  'Geraldo Pereira Rocha Filho',
  'Jacir Luiz Bordim',
  'Marcelo Antonio Marotta',
  'Marcos Fagundes Caetano',
  'Marcus Vinicius Lamar',
  'Priscila América Solís Mendez Barreto',
  'Roberto Vito Rodrigues Filho'
].sort((a, b) => a.localeCompare(b, 'pt-BR'));
---

<BaseLayout
  title="Projetos de Pesquisa | COMNET — CIC / UnB"
  description="Acervo completo de projetos de pesquisa científica e desenvolvimento tecnológico desenvolvidos pelos pesquisadores do Laboratório COMNET da Universidade de Brasília."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-unb-blue via-slate-900 to-emerald-950 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/70 border border-emerald-700/60 px-3 py-1 rounded-full">
          P&D e Inovação Científica • CIC / UnB
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold mt-3 tracking-tight">
          Projetos de Pesquisa e Desenvolvimento
        </h1>
        <p class="text-slate-300 mt-3 text-base sm:text-lg leading-relaxed">
          Acervo histórico e iniciativas vigentes do COMNET. Explore projetos ativos e concluídos, filtrando por membro participante, palavras-chave e linhas de pesquisa.
        </p>

        <!-- Contadores Rápidos -->
        <div class="flex flex-wrap gap-3 mt-6">
          <button
            type="button"
            class="stat-pill-btn px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-semibold text-white border border-white/20 transition-all flex items-center gap-2 cursor-pointer"
            data-target-filter="all"
          >
            <span>📁 Todos:</span>
            <strong class="text-sm font-bold text-white">{projetos.length}</strong>
          </button>
          <button
            type="button"
            class="stat-pill-btn px-4 py-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-xs font-semibold text-emerald-300 border border-emerald-400/30 transition-all flex items-center gap-2 cursor-pointer"
            data-target-filter="ongoing"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Ativos / Em Andamento:</span>
            <strong class="text-sm font-bold text-emerald-200">{ongoingCount}</strong>
          </button>
          <button
            type="button"
            class="stat-pill-btn px-4 py-2 rounded-xl bg-slate-700/50 hover:bg-slate-700/70 text-xs font-semibold text-slate-300 border border-slate-600/50 transition-all flex items-center gap-2 cursor-pointer"
            data-target-filter="completed"
          >
            <span>✓ Finalizados:</span>
            <strong class="text-sm font-bold text-slate-200">{completedCount}</strong>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Barra de Filtros, Abas e Busca Rápida (Sticky) -->
  <section class="py-6 bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-20 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      
      <!-- Linha 1: Abas de Separação (Ativos vs Finalizados) e Busca -->
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
        
        <!-- Abas de Separação de Status -->
        <div class="flex items-center gap-1.5 p-1 bg-slate-100 rounded-xl self-start border border-slate-200" id="status-tabs">
          <button
            type="button"
            data-filter="all"
            class="status-tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all bg-unb-blue text-white shadow-xs"
          >
            Todos ({projetos.length})
          </button>
          <button
            type="button"
            data-filter="ongoing"
            class="status-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all text-slate-700 hover:text-emerald-700 hover:bg-white/80"
          >
            🟢 Ativos ({ongoingCount})
          </button>
          <button
            type="button"
            data-filter="completed"
            class="status-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all text-slate-700 hover:text-slate-900 hover:bg-white/80"
          >
            ✓ Finalizados ({completedCount})
          </button>
        </div>

        <!-- Campo de Busca Rápida Inteligente -->
        <div class="relative flex-1 max-w-xl">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
            🔍
          </span>
          <input
            type="text"
            id="project-search"
            placeholder="Buscar por título, palavras-chave (5G, IoT, óptica...), docente ou fomento..."
            class="w-full pl-10 pr-9 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-unb-blue focus:border-unb-blue bg-slate-50 hover:bg-white transition-all"
          />
          <button
            type="button"
            id="clear-search"
            class="hidden absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-700 text-sm cursor-pointer"
            title="Limpar busca"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Linha 2: Filtro por Docente COMNET e Contador de Resultados -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-2 border-t border-slate-100 text-xs">
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <span class="font-bold text-slate-700 flex items-center gap-1 whitespace-nowrap">
            <span>👥</span>
            <span>Membro COMNET:</span>
          </span>
          <select
            id="professor-filter"
            class="px-3 py-1.5 border border-slate-300 rounded-lg text-xs bg-white text-slate-800 focus:outline-none focus:ring-2 focus:ring-unb-blue focus:border-unb-blue transition-all"
          >
            <option value="">Todos os Membros ({comnetProfessors.length} docentes)</option>
            {comnetProfessors.map((p) => (
              <option value={p}>{p}</option>
            ))}
          </select>
        </div>

        <!-- Contador Dinâmico de Projetos Exibidos -->
        <div class="text-slate-600 font-medium">
          Exibindo <span id="visible-count" class="font-bold text-unb-blue">{projetos.length}</span> de {projetos.length} projetos
        </div>
      </div>

    </div>
  </section>

  <!-- Grade Completa de Projetos -->
  <section class="py-12 bg-slate-50 min-h-[500px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projetos.map((proj) => {
          const isOngoing = proj.data.status.toLowerCase().includes('andamento') || proj.data.period.toLowerCase().includes('atual');
          const cleanSnippet = proj.body.replace(/^##\s+[^\n]+\n+/gm, '').trim().substring(0, 160) + '...';
          const profsJoined = (proj.data.professors || []).join(' ');
          const tagsJoined = (proj.data.tags || []).join(' ');
          const searchable = `${proj.data.title} ${proj.data.coordinator} ${proj.data.funding || ''} ${profsJoined} ${tagsJoined} ${proj.body}`.toLowerCase();

          return (
            <div
              class="project-item"
              data-status={isOngoing ? 'ongoing' : 'completed'}
              data-professors={profsJoined.toLowerCase()}
              data-searchable={searchable}
            >
              <ProjectCard
                slug={proj.slug}
                title={proj.data.title}
                period={proj.data.period}
                coordinator={proj.data.coordinator}
                funding={proj.data.funding}
                status={proj.data.status}
                featured={proj.data.featured}
                professors={proj.data.professors}
                tags={proj.data.tags}
                descriptionSnippet={cleanSnippet}
              />
            </div>
          );
        })}
      </div>

      <!-- Estado Vazio (Nenhum resultado) -->
      <div id="no-results" class="hidden text-center py-20 bg-white rounded-2xl border border-dashed border-slate-300 mt-6 p-8">
        <div class="text-4xl mb-3">🔍</div>
        <h3 class="text-lg font-bold text-slate-800">Nenhum projeto encontrado</h3>
        <p class="text-slate-500 text-sm mt-1 max-w-md mx-auto">
          Não encontramos nenhum projeto correspondente aos filtros e termos pesquisados. Tente buscar por outros termos ou limpar os filtros.
        </p>
        <button
          type="button"
          id="reset-filters"
          class="mt-4 px-4 py-2 bg-unb-blue hover:bg-blue-800 text-white text-xs font-bold rounded-xl transition-all shadow-xs"
        >
          Limpar filtros e ver todos os projetos
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function normalizeText(text: string): string {
    return text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
  const clearSearchBtn = document.getElementById('clear-search') as HTMLElement | null;
  const tabBtns = document.querySelectorAll('.status-tab-btn');
  const statPillBtns = document.querySelectorAll('.stat-pill-btn');
  const profSelect = document.getElementById('professor-filter') as HTMLSelectElement | null;
  const items = document.querySelectorAll('.project-item');
  const visibleCountEl = document.getElementById('visible-count');
  const noResults = document.getElementById('no-results');
  const resetFiltersBtn = document.getElementById('reset-filters');

  let currentStatus = 'all';
  let currentSearch = '';
  let currentProfessor = '';

  function setStatus(status: string) {
    currentStatus = status;
    tabBtns.forEach((btn) => {
      const b = btn as HTMLElement;
      if (b.dataset.filter === status) {
        b.classList.add('active', 'bg-unb-blue', 'text-white', 'shadow-xs');
        b.classList.remove('text-slate-700', 'hover:bg-white/80');
      } else {
        b.classList.remove('active', 'bg-unb-blue', 'text-white', 'shadow-xs');
        b.classList.add('text-slate-700', 'hover:bg-white/80');
      }
    });
    applyFilters();
  }

  function applyFilters() {
    let visible = 0;
    const normalizedTokens = currentSearch ? normalizeText(currentSearch).split(/\s+/).filter(Boolean) : [];
    const normalizedProf = currentProfessor ? normalizeText(currentProfessor) : '';

    items.forEach((item) => {
      const el = item as HTMLElement;
      const status = el.dataset.status || '';
      const searchable = normalizeText(el.dataset.searchable || '');
      const professors = normalizeText(el.dataset.professors || '');

      // 1. Status Filter
      const matchesStatus = currentStatus === 'all' || status === currentStatus;

      // 2. Professor Filter
      const matchesProfessor = !normalizedProf || professors.includes(normalizedProf);

      // 3. Search Filter (tokens match)
      let matchesSearch = true;
      if (normalizedTokens.length > 0) {
        matchesSearch = normalizedTokens.every((token) => searchable.includes(token));
      }

      if (matchesStatus && matchesProfessor && matchesSearch) {
        el.style.display = '';
        visible++;
      } else {
        el.style.display = 'none';
      }
    });

    if (visibleCountEl) {
      visibleCountEl.textContent = String(visible);
    }
    if (noResults) {
      noResults.classList.toggle('hidden', visible > 0);
    }
  }

  // Handle Search Input
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle('hidden', currentSearch.length === 0);
      }
      applyFilters();
    });
  }

  if (clearSearchBtn && searchInput) {
    clearSearchBtn.addEventListener('click', () => {
      searchInput.value = '';
      currentSearch = '';
      clearSearchBtn.classList.add('hidden');
      applyFilters();
      searchInput.focus();
    });
  }

  // Handle Status Tabs
  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = (btn as HTMLElement).dataset.filter || 'all';
      setStatus(target);
    });
  });

  // Handle Hero Stat Pills
  statPillBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = (btn as HTMLElement).dataset.targetFilter || 'all';
      setStatus(target);
      // Scroll to filter bar smoothly
      const statusTabs = document.getElementById('status-tabs');
      if (statusTabs) {
        statusTabs.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });

  // Handle Professor Select
  if (profSelect) {
    profSelect.addEventListener('change', () => {
      currentProfessor = profSelect.value;
      applyFilters();
    });
  }

  // Handle Reset Filters Button
  if (resetFiltersBtn) {
    resetFiltersBtn.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        currentSearch = '';
      }
      if (clearSearchBtn) {
        clearSearchBtn.classList.add('hidden');
      }
      if (profSelect) {
        profSelect.value = '';
        currentProfessor = '';
      }
      setStatus('all');
    });
  }

  // Initialize from URL query parameters (e.g. ?status=ongoing or ?prof=marotta)
  const urlParams = new URLSearchParams(window.location.search);
  const statusParam = urlParams.get('status');
  if (statusParam === 'ongoing' || statusParam === 'completed') {
    setStatus(statusParam);
  }
  const profParam = urlParams.get('prof');
  if (profParam && profSelect) {
    for (const opt of Array.from(profSelect.options)) {
      if (normalizeText(opt.value).includes(normalizeText(profParam))) {
        profSelect.value = opt.value;
        currentProfessor = opt.value;
        break;
      }
    }
    applyFilters();
  }
</script>
