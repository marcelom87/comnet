---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((projeto) => ({
    params: { slug: projeto.slug },
    props: { projeto },
  }));
}

const { projeto } = Astro.props;
const { Content } = await projeto.render();
const baseUrl = import.meta.env.BASE_URL;

const isOngoing = projeto.data.status.includes('andamento') || projeto.data.period.includes('Atual');
---

<BaseLayout
  title={`${projeto.data.title} | COMNET — CIC / UnB`}
  description={`Detalhes do projeto de pesquisa ${projeto.data.title} no Laboratório COMNET da Universidade de Brasília.`}
>
  <div class="bg-gradient-to-r from-unb-blue to-slate-900 text-white py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <a href={`${baseUrl}projetos/`} class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1 transition-colors">
          <span>←</span>
          <span>Voltar para Projetos</span>
        </a>
      </div>

      <div class="flex items-center gap-2 mb-3">
        <span class={`text-xs font-bold px-2.5 py-1 rounded-md ${
          isOngoing ? 'bg-emerald-500 text-slate-950' : 'bg-slate-700 text-slate-200'
        }`}>
          {isOngoing ? '● Projeto em Andamento' : '✓ Concluído'}
        </span>
        <span class="text-xs font-semibold text-slate-300 bg-white/10 px-2.5 py-1 rounded-md">
          {projeto.data.period}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-snug">
        {projeto.data.title}
      </h1>

      <p class="text-emerald-300 font-medium text-sm mt-3">
        Coordenação: {projeto.data.coordinator}
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Conteúdo Markdown do Projeto -->
      <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-8 shadow-sm prose prose-slate max-w-none prose-headings:text-unb-blue">
        <Content />
      </div>

      <!-- Barra Lateral -->
      <div class="space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">
            Metadados do Projeto
          </h3>
          <dl class="space-y-3 text-xs">
            <div>
              <dt class="font-bold text-slate-400 uppercase">Período de Vigência</dt>
              <dd class="text-slate-800 font-semibold mt-0.5">{projeto.data.period}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-400 uppercase">Coordenação</dt>
              <dd class="text-slate-800 font-semibold mt-0.5">{projeto.data.coordinator}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-400 uppercase">Financiador</dt>
              <dd class="text-slate-800 font-semibold mt-0.5">{projeto.data.funding || 'Não informado / Recursos Próprios'}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-400 uppercase">Situação</dt>
              <dd class="text-slate-800 font-semibold mt-0.5">{projeto.data.status}</dd>
            </div>
          </dl>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
          <h4 class="text-xs font-bold text-slate-700 uppercase mb-2">Instituição Executora</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Laboratório COMNET • Departamento de Ciência da Computação (CIC) • Universidade de Brasília (UnB).
          </p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
