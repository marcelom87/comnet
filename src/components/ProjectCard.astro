---
interface Props {
  slug: string;
  title: string;
  period: string;
  coordinator: string;
  funding?: string;
  status: string;
  featured?: boolean;
  descriptionSnippet?: string;
}

const { slug, title, period, coordinator, funding, status, featured, descriptionSnippet } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

const isOngoing = status.toLowerCase().includes('andamento') || period.toLowerCase().includes('atual');
---

<div class={`rounded-2xl border p-6 flex flex-col justify-between transition-all duration-300 hover:shadow-lg ${
  featured
    ? 'bg-gradient-to-br from-white to-emerald-50/40 border-emerald-300 shadow-sm'
    : 'bg-white border-slate-200'
}`}>
  <div>
    <!-- Badges Superiores -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-slate-100 text-slate-700">
        📅 {period}
      </span>
      <span class={`text-xs font-bold px-2.5 py-1 rounded-md ${
        isOngoing
          ? 'bg-emerald-100 text-emerald-800 border border-emerald-300'
          : 'bg-slate-100 text-slate-600'
      }`}>
        {isOngoing ? '● Em Andamento' : '✓ Concluído'}
      </span>
    </div>

    <!-- Título do Projeto -->
    <h3 class="text-lg font-bold text-slate-900 hover:text-unb-blue transition-colors mb-2 leading-snug">
      <a href={`${baseUrl}projetos/${slug}/`}>
        {title}
      </a>
    </h3>

    <!-- Coordenação & Financiamento -->
    <div class="space-y-1 text-xs text-slate-500 mb-4">
      <p>
        <strong class="text-slate-700">Coordenação:</strong> {coordinator}
      </p>
      {funding && (
        <p>
          <strong class="text-slate-700">Fomento:</strong> {funding}
        </p>
      )}
    </div>

    {descriptionSnippet && (
      <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">
        {descriptionSnippet}
      </p>
    )}
  </div>

  <!-- Ação -->
  <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
    <a
      href={`${baseUrl}projetos/${slug}/`}
      class="text-xs font-bold text-unb-blue hover:text-unb-green flex items-center gap-1 transition-colors"
    >
      <span>Ver Detalhes do Projeto</span>
      <span>→</span>
    </a>
  </div>
</div>
