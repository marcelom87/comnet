---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const currentUrl = Astro.url;
const lang = Astro.props.lang || getLangFromUrl(currentUrl);
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? `${baseUrl}/en` : baseUrl;
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      
      <!-- Coluna 1: Sobre COMNET -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-lg">
            CN
          </div>
          <div>
            <h3 class="text-white font-bold text-lg">COMNET</h3>
            <p class="text-xs text-slate-400">{t('footer.about')}</p>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-md">
          {t('footer.desc')}
        </p>
        <div class="flex items-center gap-3 pt-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-slate-800 text-emerald-400 border border-slate-700">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            CIC / UnB
          </span>
          <span class="text-xs text-slate-400">
            Campus Darcy Ribeiro
          </span>
        </div>
      </div>

      <!-- Coluna 2: Navegação Rápida -->
      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">
          {lang === 'en' ? 'Quick Links' : 'Navegação'}
        </h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`${prefix}/`} class="hover:text-emerald-400 transition-colors">{t('nav.home')}</a></li>
          <li><a href={`${prefix}/professores/`} class="hover:text-emerald-400 transition-colors">{t('nav.members')}</a></li>
          <li><a href={`${prefix}/projetos/`} class="hover:text-emerald-400 transition-colors">{t('nav.projects')}</a></li>
          <li><a href={`${prefix}/alunos/`} class="hover:text-emerald-400 transition-colors">{t('nav.students')}</a></li>
          <li><a href={`${prefix}/sobre/`} class="hover:text-emerald-400 transition-colors">{t('nav.about')}</a></li>
        </ul>
      </div>

      <!-- Coluna 3: Localização & Contato -->
      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">
          {lang === 'en' ? 'Contact Info' : 'Contato Institucional'}
        </h4>
        <div class="space-y-3 text-sm text-slate-400">
          <p class="flex items-start gap-2">
            <span class="text-emerald-400">📍</span>
            <span>
              {lang === 'en' 
                ? 'CIC/EST Building, Ground Floor\nUniversity of Brasília (UnB)\nBrasília - DF, Brazil'
                : 'Prédio CIC/EST, Térreo\nUniversidade de Brasília (UnB)\nBrasília - DF, CEP 70910-900'}
            </span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-emerald-400">✉️</span>
            <a href="mailto:cic@unb.br" class="hover:text-white transition-colors">cic@unb.br</a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-emerald-400">📞</span>
            <span>+55 (61) 3107-3661</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Linha de Copyright -->
    <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        © {currentYear} {t('footer.rights')}
      </p>
      <p class="flex items-center gap-2">
        <span>Powered by</span>
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white font-semibold">Astro</a>
        <span>&</span>
        <a href="https://pages.github.com" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white font-semibold">GitHub Pages</a>
      </p>
    </div>
  </div>
</footer>
