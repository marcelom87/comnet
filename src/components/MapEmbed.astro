---
import type { Lang } from '../i18n/ui';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const currentUrl = Astro.url;
const lang = Astro.props.lang || getLangFromUrl(currentUrl);
const t = useTranslations(lang);
---

<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
  <div class="p-6 md:p-8">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-xl bg-unb-blue/10 text-unb-blue flex items-center justify-center text-xl">
        📍
      </div>
      <div>
        <h3 class="text-xl font-bold text-slate-900">{t('about.location.title')}</h3>
        <p class="text-xs text-slate-500">
          {lang === 'en' ? 'Darcy Ribeiro University Campus — Asa Norte, Brasília/DF, Brazil' : 'Campus Darcy Ribeiro — Asa Norte, Brasília/DF'}
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
          {lang === 'en' ? 'Building' : 'Prédio'}
        </h4>
        <p class="text-sm font-semibold text-slate-800">{t('about.location.building')}</p>
        <p class="text-xs text-slate-500 mt-1">
          {lang === 'en' ? 'Department of Computer Science' : 'Departamento de Ciência da Computação'}
        </p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
          {lang === 'en' ? 'Mailing Address' : 'Endereço Postal'}
        </h4>
        <p class="text-sm font-semibold text-slate-800">Campus Universitário Darcy Ribeiro</p>
        <p class="text-xs text-slate-500 mt-1">
          {lang === 'en' ? 'Asa Norte, Brasília - DF, 70910-900, Brazil' : 'Asa Norte, Brasília - DF, CEP 70910-900'}
        </p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
          {lang === 'en' ? 'Official Contacts' : 'Contatos Oficiais'}
        </h4>
        <p class="text-sm font-semibold text-slate-800">Email: cic@unb.br</p>
        <p class="text-xs text-slate-500 mt-1">Phone: +55 (61) 3107-3661</p>
      </div>
    </div>
  </div>

  <!-- Google Maps Embed -->
  <div class="w-full h-80 bg-slate-100 relative border-t border-slate-200">
    <iframe
      title="Google Maps Location CIC/EST UnB"
      src="https://maps.google.com/maps?q=CIC%20UnB%20Brasilia&t=&z=16&ie=UTF8&iwloc=&output=embed"
      class="w-full h-full border-0"
      loading="lazy"
      allowfullscreen
    ></iframe>
  </div>
</div>
