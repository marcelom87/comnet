---
const baseUrl = import.meta.env.BASE_URL;
---

<section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-unb-blue-dark to-unb-blue text-white py-20 lg:py-28">
  <!-- Efeito de fundo / Grid decorativo -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:16px_16px]"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Texto Principal Hero -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-semibold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Universidade de Brasília • CIC / UnB
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
          COMNET <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">Laboratory</span>
        </h1>

        <p class="text-xl sm:text-2xl font-light text-slate-200">
          Laboratório de Redes de Comunicações e Computação Avançada
        </p>

        <p class="text-base text-slate-300 leading-relaxed max-w-2xl">
          Desenvolvendo pesquisa de fronteira em <strong>Redes 5G/6G</strong>, <strong>Softwarização de Redes (SDN/NFV)</strong>, <strong>Internet das Coisas (IoT)</strong>, <strong>Sistemas Distribuídos</strong> e <strong>Inteligência Artificial Aplicada</strong> no Departamento de Ciência da Computação da UnB.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href={`${baseUrl}professores/`}
            class="px-6 py-3.5 rounded-xl font-semibold bg-emerald-500 hover:bg-emerald-600 text-slate-950 transition-all shadow-lg hover:shadow-emerald-500/25 flex items-center gap-2 group"
          >
            <span>Conhecer Pesquisadores</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href={`${baseUrl}projetos/`}
            class="px-6 py-3.5 rounded-xl font-semibold bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-all backdrop-blur-sm"
          >
            Ver Projetos & Parcerias
          </a>
        </div>

        <!-- Badges rápidas de estatísticas -->
        <div class="grid grid-cols-3 gap-4 pt-8 border-t border-slate-700/60 max-w-lg">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400">10</div>
            <div class="text-xs text-slate-400 uppercase tracking-wide">Professores</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400">25+</div>
            <div class="text-xs text-slate-400 uppercase tracking-wide">Alunos Ativos</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400">120+</div>
            <div class="text-xs text-slate-400 uppercase tracking-wide">Egressos Formados</div>
          </div>
        </div>
      </div>

      <!-- Imagens do Laboratório / Destaque Visual -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none space-y-4">
          
          <!-- Imagem 1: Lab Real -->
          <div class="relative group rounded-2xl overflow-hidden shadow-2xl border border-slate-700 bg-slate-800">
            <img
              src={`${baseUrl}images/lab.jpg`}
              alt="Ambiente de Pesquisa e Bancadas do COMNET"
              class="w-full h-56 sm:h-64 object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent flex items-end p-4">
              <span class="text-xs font-medium text-slate-200 bg-slate-900/80 px-2.5 py-1 rounded-md backdrop-blur-sm">
                Ambiente de Pesquisa & Bancadas de Teste
              </span>
            </div>
          </div>

          <!-- Imagem 2: Lab Futuro / Conectividade -->
          <div class="relative group rounded-2xl overflow-hidden shadow-2xl border border-slate-700 bg-slate-800">
            <img
              src={`${baseUrl}images/lab_fut.png`}
              alt="Visão de Futuro e Inovação COMNET"
              class="w-full h-44 sm:h-48 object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent flex items-end p-4">
              <span class="text-xs font-medium text-emerald-300 bg-slate-900/80 px-2.5 py-1 rounded-md backdrop-blur-sm">
                Inovação em Redes do Futuro (5G/6G & IBN)
              </span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
